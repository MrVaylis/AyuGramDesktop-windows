+#ifdef Q_OS_WIN
+// Ticks wait for the display's vblank on a thread of their own. Qt's precise
+// timers fired on the 15.6ms system tick on Windows 11, even with
+// timeBeginPeriod(1) and timer resolution throttling disabled: a tick asked
+// for in 1-9ms arrived after 14-15ms, so wheel scrolling ran at 60fps.
+class VBlankTicker final {
+public:
+	explicit VBlankTicker(Fn<void()> tick);
+	~VBlankTicker();
+
+	[[nodiscard]] bool valid() const {
+		return _output != nullptr;
+	}
+	void request();
+
+private:
+	void run();
+
+	Fn<void()> _tick;
+	IDXGIOutput *_output = nullptr;
+	std::mutex _mutex;
+	std::condition_variable _condition;
+	bool _requested = false;
+	bool _stopping = false;
+	std::thread _thread;
+
+};
+
+namespace {
+
+// ponytail: the primary display paces everything, follow the window's
+// own output if a window on a second display with another rate matters.
+[[nodiscard]] IDXGIOutput *PrimaryOutput() {
+	using Create = HRESULT(WINAPI*)(REFIID, void**);
+	auto create = Create();
+	const auto dxgi = base::Platform::SafeLoadLibrary(L"dxgi.dll");
+	if (!dxgi
+		|| !base::Platform::LoadMethod(dxgi, "CreateDXGIFactory1", create)) {
+		return nullptr;
+	}
+	auto factory = (IDXGIFactory1*)nullptr;
+	if (FAILED(create(__uuidof(IDXGIFactory1), (void**)&factory))) {
+		return nullptr;
+	}
+	const auto primary = MonitorFromPoint({ 0, 0 }, MONITOR_DEFAULTTOPRIMARY);
+	auto result = (IDXGIOutput*)nullptr;
+	auto adapter = (IDXGIAdapter1*)nullptr;
+	auto output = (IDXGIOutput*)nullptr;
+	for (auto i = UINT(); !result; ++i) {
+		if (factory->EnumAdapters1(i, &adapter) != S_OK) {
+			break;
+		}
+		for (auto j = UINT(); !result; ++j) {
+			if (adapter->EnumOutputs(j, &output) != S_OK) {
+				break;
+			}
+			auto desc = DXGI_OUTPUT_DESC();
+			if (SUCCEEDED(output->GetDesc(&desc))
+				&& desc.Monitor == primary) {
+				result = output;
+			} else {
+				output->Release();
+			}
+		}
+		adapter->Release();
+	}
+	factory->Release();
+	return result;
+}
+
+} // namespace
+
+VBlankTicker::VBlankTicker(Fn<void()> tick)
+: _tick(std::move(tick))
+, _output(PrimaryOutput()) {
+	if (_output) {
+		_thread = std::thread([=] { run(); });
+	}
+}
+
+VBlankTicker::~VBlankTicker() {
+	if (_thread.joinable()) {
+		{
+			auto lock = std::unique_lock(_mutex);
+			_stopping = true;
+		}
+		_condition.notify_one();
+		_thread.join();
+	}
+	if (_output) {
+		_output->Release();
+	}
+}
+
+void VBlankTicker::request() {
+	{
+		auto lock = std::unique_lock(_mutex);
+		if (_requested) {
+			return;
+		}
+		_requested = true;
+	}
+	_condition.notify_one();
+}
+
+void VBlankTicker::run() {
+	auto lock = std::unique_lock(_mutex);
+	while (true) {
+		_condition.wait(lock, [&] { return _requested || _stopping; });
+		if (_stopping) {
+			return;
+		}
+		lock.unlock();
+		if (FAILED(_output->WaitForVBlank())) {
+			// ponytail: no vblank (display off or gone), approximate 60Hz.
+			std::this_thread::sleep_for(std::chrono::milliseconds(16));
+		}
+		lock.lock();
+		if (_stopping) {
+			return;
+		}
+		_requested = false;
+		lock.unlock();
+		_tick();
+		lock.lock();
+	}
+}
+#endif // Q_OS_WIN
