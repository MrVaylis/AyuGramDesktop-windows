+#ifdef Q_OS_WIN
+// Ticks keep a steady cadence at the refresh rate. Counting the period from
+// the last update let every update between ticks (the paint's own, or one
+// after a DirectManipulation callback) push the next tick back, so whatever
+// delayed the paint was added to the period and the frame rate halved.
+crl::time Manager::nextTick(crl::time now) {
+	const auto screen = QGuiApplication::primaryScreen();
+	const auto rate = screen ? screen->refreshRate() : 0.;
+	const auto period = (rate >= 30.)
+		? (1000. / rate)
+		: float64(kAnimationTick);
+	if (_nextTick <= now - period || _nextTick > now + period) {
+		_nextTick = now + period;
+	} else {
+		while (_nextTick <= now) {
+			_nextTick += period;
+		}
+	}
+	return crl::time(std::ceil(_nextTick));
+}
+
+bool Manager::requestVBlankTick() {
+	if (!_vblank) {
+		_vblank = std::make_unique<VBlankTicker>([=] {
+			InvokeQueued(delayedCallGuard(), [=] {
+				update();
+			});
+		});
+	}
+	if (!_vblank->valid()) {
+		return false;
+	}
+	_vblank->request();
+	return true;
+}
+#endif // Q_OS_WIN
+
 not_null<const QObject*> Manager::delayedCallGuard() const {
 	return static_cast<const QObject*>(this);
 }
