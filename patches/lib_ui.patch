+DiscreteScrollAnimation::DiscreteScrollAnimation(Callbacks callbacks)
+: _callbacks(std::move(callbacks))
+, _animation([=](crl::time now) { return step(now); }) {
+}
+
+// A notch only moves the target, and a spring follows it every frame.
+// Restarting an ease on each notch instead resets the speed to its peak,
+// so a spinning wheel scrolls in a sawtooth at the notch rate.
+bool DiscreteScrollAnimation::handle(int delta) {
+	if (!delta) {
+		return true;
+	}
+	const auto current = _callbacks.position();
+	if (_animation.animating() && current != _lastApplied) {
+		stop();
+	}
+	if (!_animation.animating()) {
+		_position = current;
+		_velocity = 0.;
+		_target = current;
+		_lastApplied = current;
+		_lastTime = crl::now();
+	}
+	const auto remaining = _target - current;
+	const auto sameDirection = remaining
+		&& ((remaining > 0) == (delta > 0));
+	_target = _callbacks.clamp((sameDirection ? _target : current) + delta);
+	if (!_animation.animating() && _target != current) {
+		_animation.start();
+	}
+	return true;
+}
+
+bool DiscreteScrollAnimation::step(crl::time now) {
+	if (_callbacks.position() != _lastApplied) {
+		stop();
+		return false;
+	}
+	const auto dt = float64(std::max(now - _lastTime, crl::time(0)));
+	_lastTime = now;
+
+	// Closed form, so it stays exact however long a frame took.
+	const auto w = kDiscreteScrollOmega;
+	const auto offset = _position - _target;
+	const auto c = _velocity + w * offset;
+	const auto decay = std::exp(-w * dt);
+	const auto left = (offset + c * dt) * decay;
+	_velocity = (_velocity - w * c * dt) * decay;
+	_position = _target + left;
+
+	const auto finished = (std::abs(left) < 0.5)
+		&& (std::abs(_velocity) < 0.01);
+	const auto value = _callbacks.clamp(finished
+		? _target
+		: int(base::SafeRound(_position)));
+	_lastApplied = finished ? -1 : value;
+	_callbacks.apply(value);
+	return !finished;
+}
+
+void DiscreteScrollAnimation::stop() {
+	_animation.stop();
+	_velocity = 0.;
+	_lastApplied = -1;
+}
